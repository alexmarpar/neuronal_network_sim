{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build MinGW",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++17",
                "-Iinclude",
                "-o",
                "build\\main.exe",
                "main.cpp",
                "lib\\glew32.lib",
                "lib\\glfw3.lib",
                "-lopengl32",
                "-luser32",
                "-lgdi32",
                "-lshell32"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
